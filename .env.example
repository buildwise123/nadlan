# Template only: variable names, no values.
# Copy to .env.local (ignored by Git) and fill in the values there.
# On Vercel, enter the same names under Project Settings → Environment Variables.

# --- Login: GitHub OAuth App (phase 1) ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Random string of 32+ characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Locally: http://localhost:3000 . On Vercel: the site address.
NEXTAUTH_URL=http://localhost:3000
# Numeric GitHub user id of the single allowed user (gh api user --jq .id)
ALLOWED_GITHUB_USER_ID=

# --- Airtable (phase 1) ---
# Personal Access Token, scoped to the nadlan workspace only
AIRTABLE_TOKEN=
# Workspace id (wsp...), used only by the base setup script
AIRTABLE_WORKSPACE_ID=
# Base ids (app...), filled in after the setup script creates the bases
AIRTABLE_BASE_ID=
AIRTABLE_TEST_BASE_ID=

# --- Later phases ---
RENTCAST_API_KEY=
CENSUS_API_KEY=
HUD_API_TOKEN=
APIFY_TOKEN=

# --- Optional ---
LOG_LEVEL=info
